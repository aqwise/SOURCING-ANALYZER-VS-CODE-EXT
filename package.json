{
    "name": "gemini-sourcing-analyzer",
    "displayName": "Gemini Sourcing Analyzer",
    "description": "Анализирует сообщения стаффинга и описывает компанию на основе открытых данных",
    "version": "0.0.1",
    "publisher": "your-name",
    "engines": {
        "vscode": "^1.80.0"
    },
    "activationEvents": [
        "onCommand:geminiSourcingAnalyzer.runAnalysis"
    ],
    "main": "./dist/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "geminiSourcingAnalyzer.runAnalysis",
                "title": "Gemini: Анализ стаффинг сообщения"
            }
        ],
        "configuration": {
            "title": "Gemini Sourcing Analyzer",
            "properties": {
                "geminiSourcingAnalyzer.apiKey": {
                    "type": "string",
                    "description": "Gemini API Key (используется, если не найден в .env)",
                    "default": ""
                }
            }
        }
    },
    "scripts": {
        "build": "webpack --config webpack.config.js",
        "watch": "webpack --watch --config webpack.config.js",
        "test": "node ./out/test/runTest.js",
        "vscode:prepublish": "webpack --config webpack.config.js",
        "compile": "tsc -watch -p ./"
    },
    "devDependencies": {
        "@types/vscode": "^1.80.0",
        "@types/webpack": "^5.28.5",
        "@vscode/test-electron": "^2.5.1",
        "ts-loader": "^9.5.2",
        "tslint": "^6.1.3",
        "typescript": "^5.8.3",
        "webpack": "^5.88.2",
        "webpack-cli": "^6.0.1"
    },
    "dependencies": {
        "axios": "^1.8.4",
        "dotenv": "^16.4.7",
        "gemini-sourcing-analyzer": "file:"
    }
}
